# Reference copy of the deployed /etc/systemd/system/stockticker-web.service
# (system-level unit, not a user unit).
[Unit]
Description=Stockticker web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=justin
WorkingDirectory=/home/justin/Projects/stockticker
ExecStart=/home/justin/Projects/stockticker/bin/python /home/justin/Projects/stockticker/web.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
